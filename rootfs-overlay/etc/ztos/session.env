# ztOS on the OnePlus 2: 1080x1920 panel, 3 pixels a point (360 points wide,
# as on the Galaxy S9).
export ZTMETRO_SCALE=3
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1
# GPU: hardware (Adreno 430, FD_MESA_DEBUG=sysmem: the OCMEM/GMEM path is not usable) only on
# kernels with patches 0130/0144 (cmdline op2.gpuhw=1); the other kernels answer -ENOMEM to every
# submit (noise on screen): software GL there.
if grep -q "op2.gpuhw=1" /proc/cmdline; then
	export FD_MESA_DEBUG=sysmem
else
	export GALLIUM_DRIVER=llvmpipe
	export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast
fi

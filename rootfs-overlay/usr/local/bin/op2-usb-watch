#!/bin/bash
# op2-usb-watch: keep the USB network link to the computer up (OnePlus 2).
#
# The boot image's initramfs builds the USB gadget (NCM + ACM) and ztOS's
# NetworkManager gives usb0 its address (usb0.nmconnection). After a normal
# boot from flash the link sometimes never comes up. This loop checks it
# every few seconds and repairs what it can, logging each step to the
# journal (journalctl -u op2-usb-watch):
#   - no gadget in configfs     -> build it (same as initramfs/init usb_up)
#   - gadget not on the UDC     -> bind it
#   - UDC not "configured" for a while (host never enumerated us)
#                               -> unbind and bind again, at most every 30 s
#   - usb0 without its address  -> nmcli connection up usb0 (else ip addr)
# Development safety net: when /etc/op2-usb-fallback exists and the link has
# not come up once FALLBACK_S seconds after boot, reboot into fastboot (USB
# works there), so a phone left alone can still be reached. Remove the file
# for daily use without a cable.
# It never touches anything else.
FALLBACK=/etc/op2-usb-fallback
FALLBACK_S=180
G=/sys/kernel/config/usb_gadget/op2
SERIAL=$(sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' /proc/cmdline)
case "$SERIAL" in
SECOND_PHONE_SERIAL) NET=44; MACID=0a ;;
*)        NET=42; MACID=0b ;;
esac
PHONE_IP=172.16.$NET.1

last=""
say() { [ "$*" != "$last" ] && echo "$*"; last="$*"; }

build_gadget() {
	mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
	mkdir -p $G/strings/0x409 $G/functions/ncm.usb0 $G/functions/acm.GS0 $G/configs/c.1/strings/0x409
	echo 0x18d1 > $G/idVendor; echo 0xd001 > $G/idProduct
	echo "OnePlus" > $G/strings/0x409/manufacturer
	echo "OnePlus 2 op2boot" > $G/strings/0x409/product
	echo "op2boot" > $G/strings/0x409/serialnumber
	echo "NCM + ACM" > $G/configs/c.1/strings/0x409/configuration
	echo 02:00:00:$MACID:02:01 > $G/functions/ncm.usb0/dev_addr
	echo 02:00:00:$MACID:02:02 > $G/functions/ncm.usb0/host_addr
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/ 2>/dev/null
	ln -s $G/functions/acm.GS0 $G/configs/c.1/ 2>/dev/null
}

# once at start: the USB registers that differ between a fastboot boot (works)
# and a normal one (UDC "not attached"); all in blocks that are clocked while
# the gadget is bound. QSCRATCH (dwc3-qcom glue) at 0xf92f8800, QUSB2 PHY at
# 0xf9b39000, dwc3 core at 0xf9200000 (DCTL 0xc704, DSTS 0xc70c).
dump_regs() {
	python3 - <<'PY' 2>&1
import mmap, os, struct
f = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
def rd(base, offs):
    m = mmap.mmap(f, 0x10000, mmap.MAP_SHARED, mmap.PROT_READ, offset=base)
    return " ".join("%#x=%#010x" % (o, struct.unpack("<I", m[o:o+4])[0]) for o in offs)
print("QSCRATCH", rd(0xf92f0000, [0x8810, 0x8830]))
print("QUSB2", rd(0xf9b30000, [0x9004, 0x9080, 0x9084, 0x9088, 0x908c, 0x90b4]))
print("DWC3", rd(0xf9200000, [0xc704, 0xc70c]))
PY
}
# the whole blocks, to compare a normal boot with a fastboot one line by line:
# QSCRATCH (0x100), the QUSB2 PHY (0x200) and GCC's USB clock/reset
# registers (GCC is always clocked). One file per boot in /var/log.
dump_full() {
	python3 - <<'PY' 2>&1
import mmap, os, struct
f = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
def block(name, base, start, end):
    m = mmap.mmap(f, 0x10000, mmap.MAP_SHARED, mmap.PROT_READ, offset=base)
    for o in range(start, end, 4):
        print("%s %#06x %#010x" % (name, o, struct.unpack("<I", m[o:o+4])[0]))
block("QSCRATCH", 0xf92f0000, 0x8800, 0x8900)
block("QUSB2", 0xf9b30000, 0x9000, 0x9200)
block("GCC", 0xfc400000, 0x03c0, 0x0500)
block("GCC", 0xfc400000, 0x1400, 0x1420)
PY
}
sleep 15
echo "registers 15 s after start: $(dump_regs | tr '\n' ' ')"
BOOT=$(cat /proc/sys/kernel/random/boot_id)
dump_full > /var/log/op2-usb-regs.$BOOT.txt
echo "full register dump: /var/log/op2-usb-regs.$BOOT.txt"

# Experiment (only with /etc/op2-usb-qs25): QSCRATCH_HS_PHY_CTRL bit 25 is set
# after a normal boot and clear when USB works (fastboot boot); clear it.
if [ -e /etc/op2-usb-qs25 ]; then
	python3 - <<'PY' 2>&1
import mmap, os, struct
f = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
m = mmap.mmap(f, 0x1000, offset=0xf92f8000)
v = struct.unpack("<I", m[0x810:0x814])[0]
m[0x810:0x814] = struct.pack("<I", v & ~(1 << 25))
print("HS_PHY_CTRL %#x -> %#x" % (v, struct.unpack("<I", m[0x810:0x814])[0]))
PY
	sleep 3
	echo "after clearing bit 25: $(dump_regs | tr '\n' ' ')"
fi

# Experiment (only with /etc/op2-usb-poke): "address value" lines written once
# at start, QSCRATCH only (0xf92f8800-0xf92f88ff, clocked while bound), e.g.
# the fastboot boot's values to find which one USB needs after a normal boot.
if [ -e /etc/op2-usb-poke ]; then
	python3 - /etc/op2-usb-poke <<'PY' 2>&1
import mmap, os, struct, sys
f = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
m = mmap.mmap(f, 0x1000, offset=0xf92f8000)
for line in open(sys.argv[1]):
    p = line.split()
    if len(p) != 2:
        continue
    a, v = int(p[0], 16), int(p[1], 16)
    if not 0xf92f8800 <= a <= 0xf92f88fc or a & 3:
        print("poke: %#x outside QSCRATCH, skipped" % a)
        continue
    o = a - 0xf92f8000
    old = struct.unpack("<I", m[o:o+4])[0]
    m[o:o+4] = struct.pack("<I", v)
    print("poke %#x: %#010x -> %#010x (read %#010x)" % (a, old, v, struct.unpack("<I", m[o:o+4])[0]))
PY
	sleep 3
	echo "after poke: $(dump_regs | tr '\n' ' ')"
fi

bad_since=0
last_rebind=0
while :; do
	now=$(cut -d. -f1 /proc/uptime)
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	if [ -z "$udc" ]; then
		say "no USB device controller (UDC) at all: nothing to do"
		sleep 10; continue
	fi
	if [ ! -d $G ]; then
		say "gadget missing: building it"
		build_gadget
	fi
	if [ -z "$(cat $G/UDC 2>/dev/null)" ]; then
		say "gadget not bound: binding to $udc"
		echo "$udc" > $G/UDC 2>/dev/null
	fi
	state=$(cat /sys/class/udc/$udc/state 2>/dev/null)
	if [ "$state" != configured ] && [ -z "$ever_up" ] && [ -e $FALLBACK ] &&
	   [ "$now" -ge $FALLBACK_S ]; then
		echo "no USB link $now s after boot and $FALLBACK exists: rebooting into fastboot"
		systemctl reboot --reboot-argument=bootloader
		sleep 60; continue
	fi
	if [ "$state" = configured ]; then
		ever_up=1
		bad_since=0
		if ! ip -4 addr show usb0 2>/dev/null | grep -q "inet $PHONE_IP/"; then
			say "link configured but usb0 has no $PHONE_IP: bringing it up"
			nmcli connection up usb0 >/dev/null 2>&1 ||
				{ ip addr add $PHONE_IP/24 dev usb0 2>/dev/null; ip link set usb0 up; }
		else
			say "link up: usb0 $PHONE_IP (UDC $udc configured)"
		fi
	else
		[ $bad_since = 0 ] && bad_since=$now
		say "UDC $udc state '$state' (not configured)"
		if [ $((now - bad_since)) -ge 20 ] && [ $((now - last_rebind)) -ge 30 ]; then
			echo "rebinding the gadget (state '$state' for $((now - bad_since)) s)"
			echo "" > $G/UDC 2>/dev/null; sleep 1
			echo "$udc" > $G/UDC 2>/dev/null
			last_rebind=$now
		fi
	fi
	sleep 5
done

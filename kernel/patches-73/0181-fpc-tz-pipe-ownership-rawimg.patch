+	} else if (!strcmp(tok, "raw")) {
+		/* dump immagine grezza 80x208 (0x4100 B) senza selftest 0x1f:
+		 * 1) capture_image 0x1a (req plain); 2) debug_retrieve_raw_image 0x2b
+		 * con req[4] = phys buffer immagine (tzmem) e req[8] = size; la TA
+		 * scrive l'immagine a buffer+0x10 (trasporto "modified" della TAC) */
+		void *req, *rsp, *img;
+		phys_addr_t img_phys;
+		u32 img_phys32, img_size = FP_IMG_SIZE;
+		u8 req_b[64] = {};
+
+		if (!f->app_id)
+			return -ENODEV;
+		req = qcom_tzmem_alloc(f->pool, 64, GFP_KERNEL);
+		rsp = qcom_tzmem_alloc(f->pool, 64, GFP_KERNEL);
+		img = qcom_tzmem_alloc(f->pool, FP_IMG_HDR + FP_IMG_SIZE, GFP_KERNEL);
+		if (!req || !rsp || !img) {
+			if (req)
+				qcom_tzmem_free(req);
+			if (rsp)
+				qcom_tzmem_free(rsp);
+			if (img)
+				qcom_tzmem_free(img);
+			return -ENOMEM;
+		}
+		img_phys = qcom_tzmem_to_phys(img);
+		if (img_phys >> 32) {
+			qcom_tzmem_free(req);
+			qcom_tzmem_free(rsp);
+			qcom_tzmem_free(img);
+			return -ERANGE;	/* req[4] porta un indirizzo a 32 bit */
+		}
+		img_phys32 = (u32)img_phys;
+		req_b[0] = 0x1a;
+		memcpy(req, req_b, 64);
+		memset(rsp, 0, 64);
+		ret = qcom_scm_qseecom_app_send(f->app_id, req, 64, rsp, 64);
+		memcpy(f->rsp, rsp, 64);
+		f->rsp_len = 64;
+		say(f, "raw: capture 0x1a ret %d rsp[0] %02x rsp[4] %02x", ret, f->rsp[0], f->rsp[4]);
+		if (!ret) {
+			memset(req_b, 0, sizeof(req_b));
+			req_b[0] = 0x2b;
+			memcpy(req_b + 4, &img_phys32, 4);
+			memcpy(req_b + 8, &img_size, 4);
+			memcpy(req, req_b, 64);
+			memset(rsp, 0, 64);
+			memset(img, 0, FP_IMG_HDR + FP_IMG_SIZE);
+			ret = qcom_scm_qseecom_app_send(f->app_id, req, 64, rsp, 64);
+			memcpy(f->rsp, rsp, 64);
+			f->rsp_len = 64;
+			say(f, "raw: retrieve 0x2b ret %d rsp[0] %02x rsp[4] %02x", ret, f->rsp[0], f->rsp[4]);
+			if (!ret) {
+				if (!f->raw)
+					f->raw = vzalloc(FP_IMG_SIZE);
+				if (!f->raw)
+					ret = -ENOMEM;
+				else {
+					memcpy(f->raw, (u8 *)img + FP_IMG_HDR, FP_IMG_SIZE);
+					f->raw_len = FP_IMG_SIZE;
+				}
+			}
+		}
+		qcom_tzmem_free(req);
+		qcom_tzmem_free(rsp);
+		qcom_tzmem_free(img);
 	} else {
 		return -EINVAL;
 	}

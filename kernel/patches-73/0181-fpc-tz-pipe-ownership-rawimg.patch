@@ -2375,5 +2375,39 @@ int qcom_scm_qseecom_op2_call(u32 owner, u32 svc, u32 cmd, const u64 *args, int
 EXPORT_SYMBOL_GPL(qcom_scm_qseecom_op2_call);
 
+/*
+ * QCOM_SCM_SVC_TZ is missing from the mainline service list. TZ_BLSP_MODIFY_OWNERSHIP
+ * (SMC 0x02000403: SIP owner, svc 0x04, cmd 3) cede/riprende una pipe BLSP/QUP al TZ,
+ * come fa lo stock fpc1020_tee.c (set_pipe_ownership: args qup_id, 3=TZ / 1=APSS,
+ * chiamata al probe con to_tz=true; se REE e TEE si contendono la stessa pipe il
+ * sistema crasha). OnePlus 2: sensore FPC su BLSP2 QUP6 (spi-qup-id = <6>).
+ */
+#define QCOM_SCM_SVC_TZ			0x04
+#define QCOM_SCM_TZ_BLSP_MODIFY_OWNERSHIP	0x03
+#define QCOM_SCM_TZBSP_APSS_ID		1
+#define QCOM_SCM_TZBSP_TZ_ID		3
+
+int qcom_scm_set_pipe_ownership(u32 qup_id, bool to_tz)
+{
+	struct qcom_scm_desc desc = {
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = qup_id,
+		.args[1] = to_tz ? QCOM_SCM_TZBSP_TZ_ID : QCOM_SCM_TZBSP_APSS_ID,
+		.svc = QCOM_SCM_SVC_TZ,
+		.cmd = QCOM_SCM_TZ_BLSP_MODIFY_OWNERSHIP,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (ret)
+		return ret;
+	if (res.result[0])
+		return -EINVAL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_pipe_ownership);
+

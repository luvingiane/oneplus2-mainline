+	} else if (!strcmp(tok, "pipe")) {
+		/* pipe tz|ree : cede/riprende la pipe QUP al TZ (SMC 0x02000403) */
+		bool to_tz;
+
+		if (!p || kstrtobool(p, &to_tz))

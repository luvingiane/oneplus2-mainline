+/* op2 0130: msm.op2_gpu_phys=1 — keep the SMMU attached (the attach unlocks
+ * VBIF) but drop the GPU address space: TZ refuses the secure set-up, so the
+ * SMMU does not translate the GPU stream; use physical addresses instead
+ * (msm.identity_iova=1). Same trick as 6.12 patch-612 0104. */
+static bool op2_gpu_phys;
+module_param_named(op2_gpu_phys, op2_gpu_phys, bool, 0644);
+
+/* The 7.x submit path needs a VM (resv object, last_fence, per-BO VMA), so
+ * instead of no address space the GPU gets a VM whose MMU does nothing: with
+ * msm.identity_iova the VMAs sit at IOVA == PA (see msm_gem.c), the SMMU
+ * does not translate the stream, so map/unmap have nothing to program. */
+static void op2_nop_detach(struct msm_mmu *mmu) {}
+static void op2_nop_destroy(struct msm_mmu *mmu) { kfree(mmu); }
+static void op2_nop_set_stall(struct msm_mmu *mmu, bool enable) {}
+static int op2_nop_map(struct msm_mmu *mmu, uint64_t iova, struct sg_table *sgt,
+		       size_t off, size_t len, int prot) { return 0; }
+static int op2_nop_unmap(struct msm_mmu *mmu, uint64_t iova, size_t len) { return 0; }
+static void op2_nop_prealloc_count(struct msm_mmu *mmu, struct msm_mmu_prealloc *p,
+				   uint64_t iova, size_t len) {}
+static int op2_nop_prealloc_allocate(struct msm_mmu *mmu, struct msm_mmu_prealloc *p) { return 0; }
+static void op2_nop_prealloc_cleanup(struct msm_mmu *mmu, struct msm_mmu_prealloc *p) {}
+
+static const struct msm_mmu_funcs op2_nop_mmu_funcs = {
+	.detach = op2_nop_detach,
+	.destroy = op2_nop_destroy,
+	.set_stall = op2_nop_set_stall,
+	.map = op2_nop_map,
+	.unmap = op2_nop_unmap,
+	.prealloc_count = op2_nop_prealloc_count,
+	.prealloc_allocate = op2_nop_prealloc_allocate,
+	.prealloc_cleanup = op2_nop_prealloc_cleanup,
+};
+
+static struct drm_gpuvm *op2_nop_vm_create(struct drm_device *drm,
+					   struct platform_device *pdev)
+{
+	struct drm_gpuvm *vm;
+	struct msm_mmu *mmu = kzalloc(sizeof(*mmu), GFP_KERNEL);
+
+	if (!mmu)
+		return ERR_PTR(-ENOMEM);
+	msm_mmu_init(mmu, &pdev->dev, &op2_nop_mmu_funcs, MSM_MMU_IOMMU);
+	/* the a4xx addresses 32 bits: all of RAM below 4 GiB */
+	vm = msm_gem_vm_create(drm, mmu, "gpu", SZ_1M, SZ_4G - SZ_1M, true);
+	if (IS_ERR(vm))
+		kfree(mmu);
+	return vm;
+}

@@ -149,6 +188,10 @@
 
 		writel_relaxed(0x0, csiphy->base +
 			       CAMSS_CSI_PHY_LNn_CFG2(l));
+		writel_relaxed(0x0, csiphy->base +
+			       CAMSS_CSI_PHY_LNn_MISC1(l));
+		writel_relaxed(0x0, csiphy->base +
+			       CAMSS_CSI_PHY_LNn_TEST_IMP(l));
 	}
 
 	writel_relaxed(0x0, csiphy->base + CAMSS_CSI_PHY_GLBL_PWR_CFG);

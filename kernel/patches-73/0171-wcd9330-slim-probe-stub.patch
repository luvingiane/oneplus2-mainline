--- a/sound/soc/codecs/wcd9330.c
+++ b/sound/soc/codecs/wcd9330.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * WCD9330 (Tomtom) codec: probe stub for the OnePlus 2.
+ *
+ * Powers the codec, releases its reset and, when the SLIMbus master reports
+ * it present, reads its chip id (physical registers 0x804..0x807, expected
+ * 00 00 05 01 on the WCD9330 per the CAF wcd9330_registers.h). It is NOT a
+ * codec driver yet: no DAIs, no controls (task 328, step 2 of the plan).
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slimbus.h>
+
+#define WCD9330_PHYS_CHIP_ID		0x804
+#define WCD9330_ID_BYTES		4
+
+
+struct wcd9330 {
+	struct device *dev;
+	struct regulator_bulk_data supplies[6];
+	struct gpio_desc *reset;
+	struct clk *mclk;
+	struct regmap *regmap;
+	struct slim_device *slim_ifc_dev;
+};
+
+static const struct regmap_config wcd9330_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xfff,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int wcd9330_slim_status(struct slim_device *sdev, enum slim_device_status status)
+{
+	struct device *dev = &sdev->dev;
+	struct wcd9330 *wcd = dev_get_drvdata(dev);
+	struct device_node *ifc_np;
+	u8 id[WCD9330_ID_BYTES] = {};
+	int i, ret;
+
+	if (!wcd || status != SLIM_DEVICE_STATUS_UP)
+		return 0;
+	dev_info(dev, "op2dbg: slimbus device is up\n");
+
+	if (!wcd->regmap) {
+		ifc_np = of_parse_phandle(dev->of_node, "slim-ifc-dev", 0);
+		if (ifc_np) {
+			wcd->slim_ifc_dev = of_slim_get_device(sdev->ctrl, ifc_np);
+			of_node_put(ifc_np);
+			if (wcd->slim_ifc_dev)
+				slim_get_logical_addr(wcd->slim_ifc_dev);
+		}
+		wcd->regmap = regmap_init_slimbus(sdev, &wcd9330_regmap_config);
+		if (IS_ERR(wcd->regmap)) {
+			ret = PTR_ERR(wcd->regmap);
+			wcd->regmap = NULL;
+			return dev_err_probe(dev, ret, "regmap\n");
+		}
+	}
+
+	for (i = 0; i < WCD9330_ID_BYTES; i++) {
+		unsigned int v = 0;
+
+		ret = regmap_read(wcd->regmap, WCD9330_PHYS_CHIP_ID + i, &v);
+		if (ret) {
+			dev_err(dev, "op2dbg: chip id byte %d read failed: %d\n", i, ret);
+			return ret;
+		}
+		id[i] = v;
+	}
+	dev_info(dev, "op2dbg: chip id %02x %02x %02x %02x\n", id[0], id[1], id[2], id[3]);
+	return 0;
+}
+
+static int wcd9330_slim_probe(struct slim_device *sdev)
+{
+	struct device *dev = &sdev->dev;
+	struct wcd9330 *wcd;
+	int ret;
+
+	/* the interface device (reg = <0 0>) has nothing to power */
+	if (sdev->e_addr.dev_index == 0)
+		return 0;
+
+	wcd = devm_kzalloc(dev, sizeof(*wcd), GFP_KERNEL);
+	if (!wcd)
+		return -ENOMEM;
+	wcd->dev = dev;
+	dev_set_drvdata(dev, wcd);
+
+	/* CAF order: buck (s5), the 1.2 V rail (l11), then the 1.8 V rails (s4) */
+	wcd->supplies[0].supply = "vdd-buck";
+	wcd->supplies[1].supply = "vdd-a-1p2v";
+	wcd->supplies[2].supply = "vddcx";
+	wcd->supplies[3].supply = "vdd-tx";
+	wcd->supplies[4].supply = "vdd-rx";
+	wcd->supplies[5].supply = "vdd-io";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(wcd->supplies), wcd->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "supplies\n");
+
+	wcd->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);	/* asserted */
+	if (IS_ERR(wcd->reset))
+		return dev_err_probe(dev, PTR_ERR(wcd->reset), "reset gpio\n");
+
+	wcd->mclk = devm_clk_get_optional(dev, "mclk");
+	if (IS_ERR(wcd->mclk))
+		return dev_err_probe(dev, PTR_ERR(wcd->mclk), "mclk\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(wcd->supplies), wcd->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "enable supplies\n");
+	ret = clk_prepare_enable(wcd->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(wcd->supplies), wcd->supplies);
+		return dev_err_probe(dev, ret, "enable mclk\n");
+	}
+
+	msleep(20);
+	gpiod_set_value_cansleep(wcd->reset, 0);	/* released */
+	dev_info(dev, "op2dbg: rails on, reset released\n");
+	return 0;
+}
+
+static void wcd9330_slim_remove(struct slim_device *sdev)
+{
+	struct wcd9330 *wcd = dev_get_drvdata(&sdev->dev);
+
+	if (!wcd)
+		return;
+	gpiod_set_value_cansleep(wcd->reset, 1);
+	clk_disable_unprepare(wcd->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(wcd->supplies), wcd->supplies);
+}
+
+static const struct slim_device_id wcd9330_slim_id[] = {
+	{ 0x217, 0x130, 0x1, 0x0 },
+	{ 0x217, 0x130, 0x0, 0x0 },
+	{}
+};
+MODULE_DEVICE_TABLE(slim, wcd9330_slim_id);
+
+static struct slim_driver wcd9330_slim_driver = {
+	.driver = {
+		.name = "wcd9330-slim",
+	},
+	.probe = wcd9330_slim_probe,
+	.remove = wcd9330_slim_remove,
+	.device_status = wcd9330_slim_status,
+	.id_table = wcd9330_slim_id,
+};
+module_slim_driver(wcd9330_slim_driver);
+
+MODULE_DESCRIPTION("WCD9330 (Tomtom) slim probe stub");
+MODULE_LICENSE("GPL v2");

--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -586,4 +586,10 @@
 source "drivers/misc/amd-sbi/Kconfig"
 source "drivers/misc/rp1/Kconfig"
 source "drivers/misc/issei/Kconfig"
+config OP2_PMICDBG
+	tristate "OnePlus 2 PM8994 read-only register dump"
+	depends on REGMAP && OF
+	help
+	  Debug sysfs files to read PM8994 clock-distribution registers.
+
 endmenu
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -71,3 +71,4 @@
 obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
 obj-$(CONFIG_INTEL_SSEI)	+= issei/
+obj-$(CONFIG_OP2_PMICDBG)	+= op2-pmicdbg.o
--- /dev/null
+++ b/drivers/misc/op2-pmicdbg.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OnePlus 2: sola lettura dei registri del PM8994 (SPMI slave 0) da sysfs,
+ * per vedere se i buffer di clock (CLK_DIST, 0x5000-0x58ff) sono accesi.
+ *   cat clk            -> per ogni blocco: tipo/sottotipo e registri 0x40-0x4f
+ *   echo 0x5046 > addr; cat val
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+struct op2_pmicdbg {
+	struct regmap *map;
+	unsigned int addr;
+};
+
+static ssize_t clk_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct op2_pmicdbg *p = dev_get_drvdata(dev);
+	unsigned int base, off, v, type, sub;
+	int n = 0;
+
+	for (base = 0x5000; base < 0x5900; base += 0x100) {
+		if (regmap_read(p->map, base + 4, &type) ||
+		    regmap_read(p->map, base + 5, &sub))
+			continue;
+		if (!type)
+			continue;
+		n += scnprintf(buf + n, PAGE_SIZE - n, "%04x type %02x sub %02x:", base, type, sub);
+		for (off = 0x40; off < 0x50 && n < PAGE_SIZE - 8; off++) {
+			if (regmap_read(p->map, base + off, &v))
+				break;
+			n += scnprintf(buf + n, PAGE_SIZE - n, " %02x", v);
+		}
+		n += scnprintf(buf + n, PAGE_SIZE - n, "\n");
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(clk);
+
+/* SPMI regulators S8..S12 (PM8994 slave 1): type/sub, status, enable and the FTS426 voltage word */
+static ssize_t rails_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	static const unsigned int bases[] = { 0x2900, 0x2c00, 0x2f00, 0x3200, 0x3500 };
+	struct op2_pmicdbg *p = dev_get_drvdata(dev);
+	unsigned int i, type, sub, st, en, lsb, msb;
+	int n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(bases); i++) {
+		if (regmap_read(p->map, bases[i] + 4, &type) ||
+		    regmap_read(p->map, bases[i] + 5, &sub) ||
+		    regmap_read(p->map, bases[i] + 8, &st) ||
+		    regmap_read(p->map, bases[i] + 0x46, &en) ||
+		    regmap_read(p->map, bases[i] + 0x40, &lsb) ||
+		    regmap_read(p->map, bases[i] + 0x41, &msb))
+			continue;
+		n += scnprintf(buf + n, PAGE_SIZE - n,
+			       "s%u base %04x type %02x sub %02x status %02x en %02x vset %u mV\n",
+			       8 + i, bases[i], type, sub, st, en, (msb << 8) | lsb);
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(rails);
+
+static ssize_t addr_store(struct device *dev, struct device_attribute *a, const char *buf, size_t len)
+{
+	struct op2_pmicdbg *p = dev_get_drvdata(dev);
+
+	return kstrtouint(buf, 0, &p->addr) ? -EINVAL : len;
+}
+static DEVICE_ATTR_WO(addr);
+
+static ssize_t val_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct op2_pmicdbg *p = dev_get_drvdata(dev);
+	unsigned int v;
+	int ret = regmap_read(p->map, p->addr, &v);
+
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%04x: %02x\n", p->addr, v);
+}
+static DEVICE_ATTR_RO(val);
+
+static struct attribute *op2_pmicdbg_attrs[] = {
+	&dev_attr_clk.attr, &dev_attr_rails.attr, &dev_attr_addr.attr, &dev_attr_val.attr, NULL
+};
+ATTRIBUTE_GROUPS(op2_pmicdbg);
+
+static int op2_pmicdbg_probe(struct platform_device *pdev)
+{
+	struct op2_pmicdbg *p;
+
+	p = devm_kzalloc(&pdev->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->map = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!p->map)
+		return -ENODEV;
+	platform_set_drvdata(pdev, p);
+	return 0;
+}
+
+static const struct of_device_id op2_pmicdbg_of[] = {
+	{ .compatible = "oneplus,op2-pmicdbg" }, { }
+};
+MODULE_DEVICE_TABLE(of, op2_pmicdbg_of);
+
+static struct platform_driver op2_pmicdbg_driver = {
+	.probe = op2_pmicdbg_probe,
+	.driver = { .name = "op2-pmicdbg", .of_match_table = op2_pmicdbg_of,
+		    .dev_groups = op2_pmicdbg_groups },
+};
+module_platform_driver(op2_pmicdbg_driver);
+MODULE_DESCRIPTION("OnePlus 2 PM8994 read-only register dump");
+MODULE_LICENSE("GPL");

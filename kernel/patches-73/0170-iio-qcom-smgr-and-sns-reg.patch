+static const struct group_map_entry *group_map_entry_by_id(short gid)
+{
+	const struct group_map_entry *entry;
+	int index = 0;
+
+	while ((entry = &group_map[index++])->size)
+		if (entry->group_id == gid)
+			return entry;
+	return NULL;
+}

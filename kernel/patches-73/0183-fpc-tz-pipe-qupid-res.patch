--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -2409,6 +2409,39 @@
 EXPORT_SYMBOL_GPL(qcom_scm_set_pipe_ownership);
 
 /*
+ * Come qcom_scm_set_pipe_ownership(), ma riporta anche la risposta completa del
+ * TZ (result[0..2]): serve per capire se TZ accetta la cessione (result[0]=0)
+ * e quali pipe/owner riporta. Patch 0183 (task 351): qup_id esplicito per
+ * provare la numerazione global (11/12) oltre a quella per-BLSP (6) dello stock.
+ */
+int qcom_scm_set_pipe_ownership_res(u32 qup_id, bool to_tz, u64 res3[3])
+{
+	struct qcom_scm_desc desc = {
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = qup_id,
+		.args[1] = to_tz ? QCOM_SCM_TZBSP_TZ_ID : QCOM_SCM_TZBSP_APSS_ID,
+		.svc = QCOM_SCM_SVC_TZ,
+		.cmd = QCOM_SCM_TZ_BLSP_MODIFY_OWNERSHIP,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (res3) {
+		res3[0] = res.result[0];
+		res3[1] = res.result[1];
+		res3[2] = res.result[2];
+	}
+	if (ret)
+		return ret;
+	if (res.result[0])
+		return -EINVAL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_pipe_ownership_res);
+
+/*
  * We do not yet support re-entrant calls via the qseecom interface. To prevent
  + any potential issues with this, only allow validated machines for now.
  */

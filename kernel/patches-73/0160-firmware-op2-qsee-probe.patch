+/**
+ * qcom_scm_qseecom_op2_call() - Generic QSEECOM SCM call with plain value arguments.
+ * @owner: TZ owner (QSEECOM_TZ_OWNER_*).
+ * @svc:   TZ service.
+ * @cmd:   TZ command.
+ * @args:  Up to 4 value arguments.
+ * @nargs: Number of arguments.
+ * @types: Argument types, 2 bits per argument (0 VAL, 1 RO, 2 RW, 3 BUFVAL).
+ * @res3:  Response: result, response type, data.
+ *
+ * OnePlus 2 bring-up helper (APP_START, region notification, service image load).
+ */
+int qcom_scm_qseecom_op2_call(u32 owner, u32 svc, u32 cmd, const u64 *args, int nargs,
+			      u32 types, u64 res3[3])
+{
+	struct qcom_scm_desc desc = {};
+	struct qcom_scm_qseecom_resp res = {};
+	int i, ret;
+
+	if (nargs < 0 || nargs > 4)
+		return -EINVAL;
+	desc.owner = owner;
+	desc.svc = svc;
+	desc.cmd = cmd;
+	/* types: 2 bits per argument, 0 = VAL, 1 = RO buffer, 2 = RW buffer, 3 = BUFVAL */
+	desc.arginfo = (nargs & 0xf) | ((types & 0xff) << 4);
+	for (i = 0; i < nargs; i++)
+		desc.args[i] = args[i];
+	ret = qcom_scm_qseecom_call(&desc, &res);
+	res3[0] = res.result;
+	res3[1] = res.resp_type;
+	res3[2] = res.data;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_qseecom_op2_call);

-	/* op2 0137: power-up after the init table (CAF pcie_phy_init writes
-	 * PWRDN=0x01 then START=0x03 at the end): without this the PHY stays
-	 * in PWRDN=0x3 and the PLL never locks. */
-	writel(0x01, qphy->base + PCIE_PHY_POWER_DOWN_CONTROL);
-	writel(0x03, qphy->base + PCIE_PHY_START);
+	/* op2 0137, param-gated by 273-01: CAF pcie_phy_init leaves the final
+	 * PWRDN=0x03 (pci-msm.c:973); the 0x01 re-write is a deviation. */
+	if (op2_pcie_pwrdn01) {
+		writel(0x01, qphy->base + PCIE_PHY_POWER_DOWN_CONTROL);
+		writel(0x03, qphy->base + PCIE_PHY_START);
+	}
 

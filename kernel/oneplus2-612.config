# OnePlus 2 on Linux 6.12 (GPU without IOMMU, VRAM carveout): kernel/oneplus2.config
# minus BATTERY_OP2 (patch 0013 skipped) and RMI4_F1A (not in 6.12).
# OnePlus 2 additions on top of pmOS config-postmarketos-qcom-msm8994.aarch64
# Display: the bootloader's splash as a simple framebuffer (stage 1)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# a shell over USB from the initramfs: NCM network + ACM serial, built in
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# crash logs survive a reset (OnePlus ramoops region)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# a hung kernel resets the phone instead of needing a hand on the power key
CONFIG_QCOM_WDT=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_PANIC_ON_OOPS=y
CONFIG_RTC_DRV_PM8XXX=y
# touch (stage 2)
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F55=y
CONFIG_DEVMEM=y
CONFIG_LOCALVERSION="-oneplus2"
# keep the kernel under the bootloader's fixed DTB address: LK for msm8994
# loads a 64-bit kernel at 0x80000 and the DTB at 0x02500000 whatever the
# boot image header says, so Image (with BSS) must stay below 36.5 MiB
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_ACPI is not set
# a hang becomes a panic, and a panic a reset (panic=10), so the phone
# comes back by itself instead of needing the power key
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# visible signals: notification LED (PMI8994 LPG) with a heartbeat, backlight (PMI8994 WLED)
CONFIG_PWM=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
# Size. LK may put the DTB at 0x01e00000 (aboot holds that constant too), so
# the kernel (loaded at 0x80000, with BSS) must end well below it: < ~22 MiB.
# What is not needed to boot goes out of the image (modules come later).
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_NFS_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_MD is not set
# CONFIG_SCSI is not set
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_INPUT_EVDEV=y
# display: MDP5 + DSI (20nm PHY, bootloader PLL as fixed clocks) + our panel
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_PANEL_ONEPLUS2_JD35695=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_QCOM_IOMMU=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=128
CONFIG_CGROUP_BPF=y
CONFIG_QCOM_OCMEM=y
CONFIG_PHY_QCOM_QUSB2=y
# CONFIG_DEBUG_DRIVER is not set
CONFIG_LOG_BUF_SHIFT=19
# Bluetooth (QCA6174 on BLSP2 UART2, op2-bt.dtsi): built in, ztOS has no modules
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
# Wi-Fi (QCA6174 on PCIe0, op2-wifi.dtsi, patches 0019/0020): built in
CONFIG_PHY_QCOM_PCIE_MSM8994=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y

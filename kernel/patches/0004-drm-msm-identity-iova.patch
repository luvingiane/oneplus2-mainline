From: Matt
Subject: [PATCH] drm/msm: identity IOVA for GEM objects (msm.identity_iova)

Bring-up hack, not for upstream as is. On MSM8994 the MDP and the DSI
command DMA bypass the SMMU, whose stream routing TrustZone owns, and treat
IOVAs as physical addresses: the screen shows black and panel commands are
garbage. With msm.identity_iova=1 every GEM object is backed by contiguous
CMA memory and mapped at IOVA == physical address.

---
--- a/drivers/gpu/drm/msm/msm_gem.c	2026-10-25 17:41:33.143184981 +0100
+++ b/drivers/gpu/drm/msm/msm_gem.c	2026-10-25 17:41:33.171947870 +0100
@@ -23,6 +23,16 @@
 #include "msm_gpu.h"
 #include "msm_kms.h"
 
+/*
+ * Bring-up (MSM8994): the MDP and the DSI command DMA bypass the SMMU, which
+ * TrustZone owns, and use IOVAs as physical addresses. With identity_iova every
+ * GEM object is physically contiguous (CMA) and mapped at IOVA == PA, so the
+ * hardware reads the right memory either way.
+ */
+static bool identity_iova;
+module_param(identity_iova, bool, 0444);
+MODULE_PARM_DESC(identity_iova, "Contiguous buffers mapped at IOVA == physical address");
+
 static void update_device_mem(struct msm_drm_private *priv, ssize_t size)
 {
 	uint64_t total_mem = atomic64_add_return(size, &priv->total_mem);
@@ -196,7 +206,25 @@
 		struct page **p;
 		size_t npages = obj->size >> PAGE_SHIFT;
 
-		p = drm_gem_get_pages(obj);
+		if (identity_iova) {
+			struct page *pg = dma_alloc_contiguous(dev->dev, obj->size, GFP_KERNEL);
+			size_t i;
+
+			/* CMA declines single pages: the buddy allocator then */
+			if (!pg)
+				pg = alloc_pages(GFP_KERNEL | __GFP_ZERO, get_order(obj->size));
+			if (!pg)
+				return ERR_PTR(-ENOMEM);
+			p = kvmalloc_array(npages, sizeof(*p), GFP_KERNEL);
+			if (!p) {
+				dma_free_contiguous(dev->dev, pg, obj->size);
+				return ERR_PTR(-ENOMEM);
+			}
+			for (i = 0; i < npages; i++)
+				p[i] = pg + i;
+			msm_obj->contig = pg;
+		} else
+			p = drm_gem_get_pages(obj);
 
 		if (IS_ERR(p)) {
 			DRM_DEV_ERROR(dev->dev, "could not get pages: %ld\n",
@@ -256,7 +284,12 @@
 
 		update_device_mem(obj->dev->dev_private, -obj->size);
 
-		drm_gem_put_pages(obj, msm_obj->pages, true, false);
+		if (msm_obj->contig) {
+			dma_free_contiguous(obj->dev->dev, msm_obj->contig, obj->size);
+			msm_obj->contig = NULL;
+			kvfree(msm_obj->pages);
+		} else
+			drm_gem_put_pages(obj, msm_obj->pages, true, false);
 
 		msm_obj->pages = NULL;
 		update_lru(obj);
@@ -536,6 +569,17 @@
 	if (to_msm_bo(obj)->flags & MSM_BO_NO_SHARE)
 		return -EINVAL;
 
+	if (identity_iova) {
+		struct page **pages = get_pages(obj);
+
+		if (IS_ERR(pages))
+			return PTR_ERR(pages);
+		if (to_msm_bo(obj)->contig) {
+			range_start = page_to_phys(to_msm_bo(obj)->contig);
+			range_end = range_start + obj->size;
+		}
+	}
+
 	vma = get_vma_locked(obj, vm, range_start, range_end);
 	if (IS_ERR(vma))
 		return PTR_ERR(vma);
--- a/drivers/gpu/drm/msm/msm_gem.h	2026-10-25 17:41:33.144030321 +0100
+++ b/drivers/gpu/drm/msm/msm_gem.h	2026-10-25 17:41:33.172891419 +0100
@@ -200,6 +200,9 @@
 
 	uint32_t flags;
 
+	/* msm.identity_iova: physically contiguous backing (CMA), IOVA == PA */
+	struct page *contig;
+
 	/**
 	 * madv: are the backing pages purgeable?
 	 *

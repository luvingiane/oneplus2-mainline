From: Matt
Subject: [PATCH] clk: qcom: gcc-msm8994: PCIe0 pipe clock from the PHY

OnePlus 2 bring-up: pcie_0_pipe_clk_src is fed by the PCIe PHY's pipe
output (CAF clock-gcc-8994.c: F_EXT(125000000, pcie_pipe), source value 2),
not by XO. Add "pcie_0_pipe" as a second parent (fw_name on the GCC node).
---
--- a/drivers/clk/qcom/gcc-msm8994.c	2026-10-27 13:53:31.864998341 +0100
+++ b/drivers/clk/qcom/gcc-msm8994.c	2026-10-27 13:53:31.876904174 +0100
@@ -27,6 +27,7 @@
 	P_XO,
 	P_GPLL0,
 	P_GPLL4,
+	P_PCIE_0_PIPE,
 };
 
 static struct clk_alpha_pll gpll0_early = {
@@ -877,16 +878,36 @@
 	{ }
 };
 
+/*
+ * OnePlus 2 bring-up: PCIe0's pipe clock comes from the PHY (CAF
+ * clock-gcc-8994.c: F_EXT(125 MHz, pcie_pipe), source 2), not from XO;
+ * with XO the PHY never reports ready. The PHY driver provides it as
+ * "pcie_0_pipe" (fw_name on the GCC node).
+ */
+static const struct freq_tbl ftbl_pcie_0_pipe_clk_src[] = {
+	F(125000000, P_PCIE_0_PIPE, 1, 0, 0),
+	{ }
+};
+
+static const struct parent_map gcc_xo_pcie_0_pipe_map[] = {
+	{ P_XO, 0 },
+	{ P_PCIE_0_PIPE, 2 },
+};
+
+static const struct clk_parent_data gcc_xo_pcie_0_pipe[] = {
+	{ .fw_name = "xo" },
+	{ .fw_name = "pcie_0_pipe" },
+};
+
 static struct clk_rcg2 pcie_0_pipe_clk_src = {
 	.cmd_rcgr = 0x1adc,
 	.hid_width = 5,
-	.freq_tbl = ftbl_pcie_pipe_clk_src,
+	.parent_map = gcc_xo_pcie_0_pipe_map,
+	.freq_tbl = ftbl_pcie_0_pipe_clk_src,
 	.clkr.hw.init = &(struct clk_init_data){
 		.name = "pcie_0_pipe_clk_src",
-		.parent_data = &(const struct clk_parent_data){
-				.fw_name = "xo",
-		},
-		.num_parents = 1,
+		.parent_data = gcc_xo_pcie_0_pipe,
+		.num_parents = ARRAY_SIZE(gcc_xo_pcie_0_pipe),
 		.ops = &clk_rcg2_ops,
 	},
 };

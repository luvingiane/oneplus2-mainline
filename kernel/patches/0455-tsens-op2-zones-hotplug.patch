+/* Task 455: hotplug dei core A57 (cpu4-7) come lo stock qcom,msm-thermal
+ * (hotplug-temp 105 C, stock-0.dtb:8061). La riaccensione e' default OFF:
+ * su A la riaccensione di un A57 ha dato EIO e crash (LOG.md:2012, prova v1),
+ * quindi reonline_mdegc=0 = mai riaccendere fino al riavvio. */
+static int hotplug_mdegc = 105000;
+module_param_named(hotplug_mdegc, hotplug_mdegc, int, 0644);
+MODULE_PARM_DESC(hotplug_mdegc, "offline cpu4-7 at/above this temp in mdegC (0 = off, stock 105000)");
+static int reonline_mdegc;
+module_param_named(reonline_mdegc, reonline_mdegc, int, 0644);
+MODULE_PARM_DESC(reonline_mdegc, "re-online cpu4-7 at/below this temp in mdegC (0 = never, default)");
 
 #define TSENS_NUM		16
 #define TSENS_STATUS(n)		(0x1044 + 4 * (n))

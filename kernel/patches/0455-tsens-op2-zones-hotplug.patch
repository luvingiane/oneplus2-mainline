 			return ret;
 		}
 	}
 	platform_set_drvdata(pdev, tm);
+
+	if (hotplug_mdegc > 0 && cpu_possible(4)) {
+		INIT_DELAYED_WORK(&tm->hotplug_work, op2_tsens_hotplug_work);
+		schedule_delayed_work(&tm->hotplug_work, msecs_to_jiffies(1000));
+		dev_info(dev, "A57 hotplug: offline cpu4-7 at %d mdegC, reonline at %d mdegC\n",
+			 hotplug_mdegc, reonline_mdegc);
+	}
 	return 0;
 }
 

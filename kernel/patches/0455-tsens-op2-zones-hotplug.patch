+		 * (/thermal-zones, thermal-sensors = <&op2_tsens i>), register
+		 * through the OF layer so trips and cooling-maps apply; otherwise
+		 * fall back to a plain zone without trips (old behaviour). */
+		tm->s[i].tz = devm_thermal_of_zone_register(&pdev->dev, i,
+				&tm->s[i], &op2_tsens_ops);
+		if (PTR_ERR(tm->s[i].tz) == -ENODEV)
+			tm->s[i].tz = thermal_zone_device_register_with_trips(name,
+					NULL, 0, &tm->s[i], &op2_tsens_ops,
+					NULL, 0, 0);
+		else
+			tm->s[i].of_zone = true;
 		if (IS_ERR(tm->s[i].tz)) {
 			ret = PTR_ERR(tm->s[i].tz);
 			while (--i >= 0)
-				thermal_zone_device_unregister(tm->s[i].tz);
+				if (!tm->s[i].of_zone)

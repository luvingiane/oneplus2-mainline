 struct op2_tsens {
@@ -50,8 +66,62 @@
 	int base0, base1;
 	bool calibrated;
 	struct op2_tsens_sensor s[TSENS_NUM];
+	struct delayed_work hotplug_work;
 };
 
+/* max temperature over all 16 sensors, same calibration as get_temp */
+static int op2_tsens_max_temp(struct op2_tsens *tm)
+{
+	int i, t, max = -1;
+
+	for (i = 0; i < TSENS_NUM; i++) {
+		u32 v = readl(tm->base + TSENS_STATUS(i));
+		int code, span;
+
+		if (!(v & TSENS_VALID))
+			continue;
+		code = FIELD_GET(TSENS_CODE, v);
+		span = tm->base1 - tm->base0;
+		if (span <= 0)
+			continue;
+		t = 30000 + (code - (tm->base0 + tm->s[i].off)) * 90000 / span;
+		if (t > max)
+			max = t;
+	}
+	return max;
+}
+
+static void op2_tsens_hotplug_work(struct work_struct *w)
+{
+	struct op2_tsens *tm = container_of(w, struct op2_tsens, hotplug_work.work);
+	int t = op2_tsens_max_temp(tm);
+	int c;
+
+	if (t < 0)
+		goto out;
+	if (t >= hotplug_mdegc) {
+		lock_device_hotplug();
+		for (c = 4; c <= 7; c++)
+			if (cpu_online(c)) {
+				int r = device_offline(get_cpu_device(c));
+				pr_info("op2-tsens: T=%d mdegC >= %d: cpu%d offlined (%d)\n",
+					t, hotplug_mdegc, c, r);
+			}
+		unlock_device_hotplug();
+	} else if (reonline_mdegc > 0 && t <= reonline_mdegc) {
+		lock_device_hotplug();
+		for (c = 4; c <= 7; c++)
+			if (!cpu_online(c) && cpu_possible(c)) {
+				int r = device_online(get_cpu_device(c));
+				pr_info("op2-tsens: T=%d mdegC <= %d: cpu%d onlined (%d)\n",
+					t, reonline_mdegc, c, r);
+			}
+		unlock_device_hotplug();
+	}
+out:
+	schedule_delayed_work(&tm->hotplug_work, msecs_to_jiffies(250));
+}

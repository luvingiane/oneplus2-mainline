@@ -1294,6 +1294,34 @@
 }
 EXPORT_SYMBOL_GPL(qcom_scm_iommu_set_cp_pool_size);
 
+/*
+ * The version TZ reports for one of its features (a service id, e.g.
+ * QCOM_SCM_SVC_MP): major << 22 | minor << 12 | patch, as the CAF kernel's
+ * scm_get_feat_version() (OnePlus 2: CAF sets the content-protection pool
+ * size only from MP 1.1.1 on).
+ */
+int qcom_scm_get_feat_version(u32 feat, u64 *version)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_INFO,
+		.cmd = QCOM_SCM_INFO_GET_FEAT_VERSION,
+		.arginfo = QCOM_SCM_ARGS(1),
+		.args[0] = feat,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	if (!__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_INFO,
+					  QCOM_SCM_INFO_GET_FEAT_VERSION))
+		return -EOPNOTSUPP;
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (!ret)
+		*version = res.result[0];
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_get_feat_version);
+

 	return 0;
 }
 
+/* userspace may set the input current limit; it is applied to the register only
+ * for DCP/CDP (see op2_apsd_work) and capped at 1800 mA, SDP stays <= 500 mA */
+static int op2_usb_set(struct power_supply *psy, enum power_supply_property p,
+		       const union power_supply_propval *val)
+{
+	struct op2_bat *b = power_supply_get_drvdata(psy);
+
+	switch (p) {
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		if (b->usb_psy_type == POWER_SUPPLY_TYPE_USB_DCP ||
+		    b->usb_psy_type == POWER_SUPPLY_TYPE_USB_CDP)
+			set_icl(b, min(val->intval / 1000, 1800));
+		else
+			b->icl_ua = min(val->intval, 500000);
+		power_supply_changed(b->usb);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int op2_usb_is_writeable(struct power_supply *psy,
+				enum power_supply_property p)
+{
+	return p == POWER_SUPPLY_PROP_CURRENT_MAX ||
+	       p == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT;
+}

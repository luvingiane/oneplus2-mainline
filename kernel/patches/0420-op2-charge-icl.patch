+static bool usb_present(struct op2_bat *b);
+static int sram_refresh(struct op2_bat *b);
+static struct power_supply_desc op2_usb_desc; /* defined below; type follows APSD */
+
+/* write a "sec" register: 0xa5 to the peripheral's SEC_ACCESS first (same as probe) */
+static int sec_write(struct op2_bat *b, unsigned int reg, unsigned int val)
+{
+	if (regmap_write(b->map, (reg & ~0xff) | SEC_ACCESS, 0xa5))
+		return -EIO;
+	return regmap_write(b->map, reg, val) ? -EIO : 0;
+}
+
+static int current_index(int ma)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(usb_current_table) - 1; i >= 0; i--)
+		if (ma >= usb_current_table[i])
+			return i;
+	return 4; /* 500 mA fallback = FCC_500MA_VAL (qpnp-smbcharger.c:2041) */
+}
+
+/* input current limit (USBIN ICL): IL_CFG index, then CMD_IL HC mode
+ * (CAF sequence qpnp-smbcharger.c:1772-1782) */
+static int set_icl(struct op2_bat *b, int ma)
+{
+	int i = current_index(ma);
+
+	if (sec_write(b, IL_CFG, i & USBIN_INPUT_MASK))
+		return -EIO;
+	if (regmap_update_bits(b->map, CMD_IL, USBIN_MODE_CHG_BIT, USBIN_HC_MODE))
+		return -EIO;
+	b->icl_ua = usb_current_table[i] * 1000;
+	dev_info(b->dev, "ICL <- %d uA (IL_CFG %#x)\n", b->icl_ua, i & USBIN_INPUT_MASK);
+	return 0;
+}
+
+/* fast charge current (FCC): FCC_CFG index, same table (qpnp-smbcharger.c:2059-2075) */
+static int set_fcc(struct op2_bat *b, int ma)
+{
+	int i = current_index(ma);
+
+	if (sec_write(b, FCC_CFG, i & USBIN_INPUT_MASK))
+		return -EIO;
+	b->fcc_ua = usb_current_table[i] * 1000;
+	dev_info(b->dev, "FCC <- %d uA (FCC_CFG %#x)\n", b->fcc_ua, i & USBIN_INPUT_MASK);
+	return 0;
+}
+
+/* Read the APSD result (MISC IDEV_STS bits 7:4, CAF get_type qpnp-smbcharger.c:852-857)
+ * and raise the input current limit only for DCP/CDP. SDP/OTHER/NONE keep the
+ * DT/LK values (500 mA class) — CAF does the same (DEFAULT_SDP_MA 500,
+ * qpnp-smbcharger.c:4283-4287, and the SDP branch of smbchg_set_usb_current_max
+ * only allows 100/150/500/900 mA, qpnp-smbcharger.c:1820-1895). */
+static void op2_apsd_work(struct work_struct *w)
+{
+	struct op2_bat *b = container_of(to_delayed_work(w), struct op2_bat, apsd_work);
+	unsigned long t;
+	int v, idx;
+
+	if (!usb_present(b))
+		goto rearm;
+	v = rd(b, MISC_IDEV_STS);
+	if (v < 0)
+		goto rearm;
+	t = (v >> 4) & 0xf;
+	idx = find_first_bit(&t, 4); /* 4 = none of the type bits set */
+	if (idx != b->apsd_idx) {
+		b->apsd_idx = idx;
+		switch (idx) {
+		case 0:
+			b->usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+			b->usb_psy_type = POWER_SUPPLY_TYPE_USB;
+			break;
+		case 2:
+			b->usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+			b->usb_psy_type = POWER_SUPPLY_TYPE_USB_DCP;
+			break;
+		case 3:
+			b->usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+			b->usb_psy_type = POWER_SUPPLY_TYPE_USB_CDP;
+			break;
+		default:
+			b->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+			b->usb_psy_type = POWER_SUPPLY_TYPE_USB;
+			break;
+		}
+		dev_info(b->dev, "APSD IDEV_STS %#04x -> idx %d (usb_type %d)\n", v, idx, b->usb_type);
+		op2_usb_desc.type = b->usb_psy_type; /* sysfs "type" now follows APSD */
+		/* DCP: CAF DEFAULT_WALL_CHG_MA 1800 (qpnp-smbcharger.c:4280); CDP: DEFAULT_CDP_MA
+		 * 1500 (:4287). FCC capped at 2000 mA: the OP2 stock 5 V/2 A adapter draws
+		 * ~1.9 A into the 3300 mAh battery (0.6 C), see report task 420. */
+		if (idx == 2) {
+			set_icl(b, 1800);
+			set_fcc(b, 2000);
+		} else if (idx == 3) {
+			set_icl(b, 1500);
+			set_fcc(b, 1500);
+		}
+		/* SDP/other: nothing — ICL/FCC stay at the oneplus,init-regs values */
+		power_supply_changed(b->usb);
+		power_supply_changed(b->psy);
+	}
+rearm:
+	schedule_delayed_work(&b->apsd_work, 30 * HZ);
+}
+
+/* temperature guard while charging: derate FCC, restore when cool (FG SRAM temp) */
+static void op2_therm_work(struct work_struct *w)
+{
+	struct op2_bat *b = container_of(to_delayed_work(w), struct op2_bat, therm_work);
+	int target;
+
+	if (usb_present(b) && sram_refresh(b) == 0 && b->fcc_ua > 0) {
+		if (b->temp_dc > 480)
+			target = 300;
+		else if (b->temp_dc > 450)
+			target = 1000;
+		else if (b->usb_psy_type == POWER_SUPPLY_TYPE_USB_DCP)
+			target = 2000;
+		else if (b->usb_psy_type == POWER_SUPPLY_TYPE_USB_CDP)
+			target = 1500;
+		else
+			target = 500;
+		if (target != b->fcc_ua / 1000)
+			set_fcc(b, target);
+		if (b->temp_dc > 450)
+			dev_info(b->dev, "batt temp %d dC, FCC derated to %d\n", b->temp_dc, target);
+	}
+	schedule_delayed_work(&b->therm_work, 30 * HZ);
+}
+
 /* One 16-bit value at word address `addr`, byte offset 0..3: at offset 3 the high byte is byte 0 of the
  * next word (CAF qpnp-fg.c fg_mem_read() sets the address again for the next word). Access already granted. */
 static int sram_word16(struct op2_bat *b, unsigned int addr, unsigned int off)

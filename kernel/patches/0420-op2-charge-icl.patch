+static int op2_bat_set(struct power_supply *psy, enum power_supply_property p,
+		       const union power_supply_propval *val)
+{
+	struct op2_bat *b = power_supply_get_drvdata(psy);
+
+	switch (p) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		set_fcc(b, clamp(val->intval / 1000, 300, 2000));
+		power_supply_changed(b->psy);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}

+/* Charger control registers (meanings from CAF qpnp-smbcharger.c):
+ *   MISC IDEV_STS 0x0808 bits 7:4 = APSD result (bit4 SDP, bit5 OTHER, bit6 DCP,
+ *                 bit7 CDP; qpnp-smbcharger.c:701,840-846,852-857,879-895)
+ *   USBIN CMD_IL 0x1340 (bit0 USBIN_MODE_CHG_BIT -> HC mode, qpnp-smbcharger.c:1735-1737),
+ *         IL_CFG 0x13f2 (sec): input current limit, index into usb_current_table
+ *         (qpnp-smbcharger.c:1347-1380,1730-1784)
+ *   CHGR  FCC_CFG 0x10f2 (sec): fast charge current, same table (qpnp-smbcharger.c:2040-2075)
+ *   USBIN CMD_APSD 0x1341 bit0 APSD_RERUN (qpnp-smbcharger.c:5510-5511,5653-5656) */
+#define MISC_IDEV_STS	0x0808
+#define CMD_IL		0x1340
+#define IL_CFG		0x13f2
+#define FCC_CFG		0x10f2
+#define CMD_APSD	0x1341
+#define USBIN_INPUT_MASK	0x1f
+#define USBIN_MODE_CHG_BIT	BIT(0)
+#define USBIN_HC_MODE		BIT(0)
+
+/* same table as CAF qpnp-smbcharger.c:1347-1380 (usb_current_table); the FCC
+ * enumerations are the same (qpnp-smbcharger.c:2049 "the fcc enumerations are
+ * the same as the usb currents") */
+static const int usb_current_table[] = {
+	300, 400, 450, 475, 500, 550, 600, 650, 700, 900,
+	950, 1000, 1100, 1200, 1400, 1450, 1500, 1600, 1800, 1850,
+	1880, 1910, 1930, 1950, 1970, 2000, 2050, 2100, 2300, 2400,
+	2500, 3000
+};
 
